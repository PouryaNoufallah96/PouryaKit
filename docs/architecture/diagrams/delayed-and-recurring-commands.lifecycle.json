  "cards": [
    {
      "dot": "cyan",
      "title": "Scheduled only inside a commit",
      "items": [
        "IDelayedCommands.Schedule throws for reading code, with no active Unit of Work, for a type its Module did not declare, and for a recurring command.",
        "The Operation's commit writes the command as a Scheduled envelope with its due time; a rollback leaves nothing stored."
      ]
    },
    {
      "dot": "violet",
      "title": "On whose authority",
      "items": [
        "A delayed command runs as a continuation of the Operation that scheduled it: its Actor, tenant and correlation.",
        "Each recurring occurrence is a new Operation of its declared system Actor, with no tenant and no restored trace parent.",
        "The Receipt key is the envelope's id for a delayed command and the occurrence's time for a recurring one."
      ]
    },
    {
      "dot": "rose",
      "title": "Dead letters",
      "items": [
        "A retired name or the other kind is retried, then set aside: UnknownDelayedCommandException.",
        "A type no declaration names, or a body that no longer reads, is set aside at once, before the Kit's delivery runs.",
        "The dead letter keeps the failing attempt's own exception; a failure to store the next occurrence is logged beside it."
      ]
    },
    {
      "dot": "amber",
      "title": "Recovery",
      "items": [
        "Host start stores the first occurrence after now for each recurring command with none waiting on its queue.",
        "After an unreadable occurrence, start any one instance of the Host, then discard the dead letter; never replay it."
      ]
    }
  ]
