<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Host of the Saga tests' Modules, which the tests compose in their own process and package validation publishes
       in Release, as it publishes the Proving Sample's Hosts: codegen write, then a publish that carries the Sagas'
       generated chains and no runtime compiler (ADR 0004, ADR 0013). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- dotnet run reads appsettings.json from here; it is not copied, so no Host that references this one takes it. -->
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <!-- Development compiles Wolverine's handler code at run time with Roslyn from this package; a Release build loads what
       the codegen write command generated, so its publish carries no runtime compiler (ADR 0004). -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ModularMonolith.Tests.Sagas.csproj" />
    <ProjectReference Include="..\..\..\..\src\PouryaKit.Messaging.Wolverine.EFCore\PouryaKit.Messaging.Wolverine.EFCore.csproj" />
  </ItemGroup>
</Project>
