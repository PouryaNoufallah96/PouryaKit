<Project Sdk="Microsoft.NET.Sdk">
  <!-- A Host of the Accounts Stream Module alone, which the Stream tests compose in their own process and run as an OS
       process of its own to kill it between Marten's commit and Wolverine's send. ModularMonolith.Tests leaves this
       folder out of its own sources. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The shared framework the test project runs on, whose output this Host's assembly is started from. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Streams\ModularMonolith.Tests.Streams.csproj" />
    <ProjectReference Include="..\..\..\src\PouryaKit.Messaging.Wolverine.Marten\PouryaKit.Messaging.Wolverine.Marten.csproj" />
    <ProjectReference Include="..\..\..\src\PouryaKit.Testing\PouryaKit.Testing.csproj" />
  </ItemGroup>
</Project>
