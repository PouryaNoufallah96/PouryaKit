# Serena's project folder: a local tool's, like the entries above. The Kit tracks none of it.
.serena/
# The docs site's installed packages and build output, scoped to website/: a bare `out/` would ignore that name anywhere.
website/node_modules/
website/.next/
website/out/
website/.source/
website/.vercel/
website/next-env.d.ts
# The typeset covers, which `pnpm --dir website covers` writes from the committed artwork.
website/covers/out/
# The pages the content pipeline generates from the Kit's sources before each site build (website/lib/kit-sources/site.ts).
website/.generated/
website/content/docs/capabilities/
website/content/docs/reference/
