<Project Sdk="Microsoft.NET.Sdk">

  <!-- Microsoft.Testing.Platform comes from the root global.json; xunit.v3 only, no VSTest packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>S2.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../S2.Host/S2.Host.csproj" />
  </ItemGroup>

</Project>
