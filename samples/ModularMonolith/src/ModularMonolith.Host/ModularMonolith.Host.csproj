<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <!-- The application's optional distributed cache for HybridCache; a Kit package never references Redis. -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
  </ItemGroup>
  <!-- Development compiles Wolverine's handler code at run time with Roslyn from this package; a Release build loads what
       the codegen write command generated, so its publish carries no runtime compiler (ADR 0004). -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Modules\Billing\Billing\Billing.csproj" />
    <ProjectReference Include="..\Modules\Catalog\Catalog\Catalog.csproj" />
    <ProjectReference Include="..\Modules\Inventory\Inventory\Inventory.csproj" />
    <ProjectReference Include="..\..\..\..\src\PouryaKit.AI\PouryaKit.AI.csproj" />
    <ProjectReference Include="..\..\..\..\src\PouryaKit.Caching\PouryaKit.Caching.csproj" />
    <ProjectReference Include="..\..\..\..\src\PouryaKit.Email.MailKit\PouryaKit.Email.MailKit.csproj" />
    <ProjectReference Include="..\..\..\..\src\PouryaKit.Messaging.Wolverine.EFCore\PouryaKit.Messaging.Wolverine.EFCore.csproj" />
    <ProjectReference Include="..\..\..\..\src\PouryaKit.Messaging.Wolverine.RabbitMq\PouryaKit.Messaging.Wolverine.RabbitMq.csproj" />
    <ProjectReference Include="..\..\..\..\src\PouryaKit.Observability\PouryaKit.Observability.csproj" />
    <ProjectReference Include="..\..\..\..\src\PouryaKit.Realtime\PouryaKit.Realtime.csproj" />
    <ProjectReference Include="..\..\..\..\src\PouryaKit.Security\PouryaKit.Security.csproj" />
    <ProjectReference Include="..\..\..\..\src\PouryaKit.Security.JwtBearer\PouryaKit.Security.JwtBearer.csproj" />
    <ProjectReference Include="..\..\..\..\src\PouryaKit.Web\PouryaKit.Web.csproj" />
    <ProjectReference Include="..\..\..\..\src\PouryaKit.Web.OpenApi\PouryaKit.Web.OpenApi.csproj" />
  </ItemGroup>
</Project>
