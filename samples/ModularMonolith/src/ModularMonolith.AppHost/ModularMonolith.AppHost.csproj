<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UserSecretsId>pouryakit-modular-monolith-apphost</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <!-- The orchestrator and the dashboard come from the Aspire CLI bundle: the build takes the bundle of the aspire command
         on PATH or, with none, has dnx fetch the paired Aspire.Cli from NuGet and extract its bundle. -->
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <!-- AddDotnetProject runs each Host by its path, so the AppHost references none of them. -->
    <PackageReference Include="Aspire.Hosting.Dotnet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\PouryaKit.Aspire\PouryaKit.Aspire.csproj" />
  </ItemGroup>
</Project>
