{
  "Urls": "http://localhost:5090",
  "ReverseProxy": {
    "Routes": {
      "modular-monolith": {
        "ClusterId": "modular-monolith",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "modular-monolith": {
        "Destinations": {
          "host": {
            "Address": "http://modular-monolith"
          }
        }
      }
    }
  },
  "Services": {
    "modular-monolith": {
      "http": ["localhost:5080"]
    }
  }
}
