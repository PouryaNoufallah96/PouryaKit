<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- PostgreSQL in a container, migrations, the Host's start and a data reset before each test. It brings
         WolverineFx.RuntimeCompilation: the Host runs in Development here, where Wolverine compiles its handler code at run
         time, from any build. -->
    <PackageReference Include="PouryaKit.Testing" />
    <!-- The broker the Host joins as it is composed, started beside PostgreSQL. -->
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PouryaKitAppName.Host\PouryaKitAppName.Host.csproj" />
  </ItemGroup>
</Project>
