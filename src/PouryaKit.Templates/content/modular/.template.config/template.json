{
  "$schema": "https://json.schemastore.org/template",
  "author": "Pourya Nofallah",
  "classifications": ["Web", "API", "Modular monolith", "PouryaKit"],
  "identity": "PouryaKit.Templates.ModularMonolith",
  "name": "PouryaKit modular monolith",
  "description": "A Host on PouryaKit with the Proving Sample's Catalog, Billing and Inventory Modules, their Composition Roots and Gateway endpoints, with the service defaults and an HTTP smoke test.",
  "shortName": "pouryakit-modular-monolith",
  "sourceName": "ModularMonolith",
  "defaultName": "Shop",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "serviceName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "queueName",
      "replaces": "modular-monolith",
      "description": "The Host's queue on a RabbitMQ broker: the name, lower-cased, each run of other characters a hyphen."
    },
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "If specified, skips the automatic restore of the solution on create.",
      "defaultValue": "false"
    }
  },
  "forms": {
    "queueName": {
      "identifier": "chain",
      "steps": ["lowerCaseInvariant", "hyphensForOthers", "noOuterHyphens"]
    },
    "lowerCaseInvariant": {
      "identifier": "lowerCaseInvariant"
    },
    "hyphensForOthers": {
      "identifier": "replace",
      "pattern": "[^a-z0-9]+",
      "replacement": "-"
    },
    "noOuterHyphens": {
      "identifier": "replace",
      "pattern": "^-+|-+$",
      "replacement": ""
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./"
    },
    {
      "source": "../shared/",
      "target": "./"
    },
    {
      "source": "../sample/",
      "target": "src/"
    }
  ],
  "primaryOutputs": [
    {
      "path": "ModularMonolith.slnx"
    }
  ],
  "postActions": [
    {
      "id": "restore",
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages required by this solution.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
