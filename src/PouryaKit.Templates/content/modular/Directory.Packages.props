<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The PouryaKit version the solution was generated with: every Kit package has the same one. -->
    <PouryaKitVersion>0.0.0-pouryakit</PouryaKitVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="PouryaKit.AI" Version="$(PouryaKitVersion)" />
    <PackageVersion Include="PouryaKit.Caching" Version="$(PouryaKitVersion)" />
    <PackageVersion Include="PouryaKit.Grpc" Version="$(PouryaKitVersion)" />
    <PackageVersion Include="PouryaKit.Messaging.Wolverine.EFCore" Version="$(PouryaKitVersion)" />
    <PackageVersion Include="PouryaKit.Messaging.Wolverine.RabbitMq" Version="$(PouryaKitVersion)" />
    <PackageVersion Include="PouryaKit.Modularity" Version="$(PouryaKitVersion)" />
    <PackageVersion Include="PouryaKit.Observability" Version="$(PouryaKitVersion)" />
    <PackageVersion Include="PouryaKit.Persistence.Dapper" Version="$(PouryaKitVersion)" />
    <PackageVersion Include="PouryaKit.Persistence.Postgres" Version="$(PouryaKitVersion)" />
    <PackageVersion Include="PouryaKit.Realtime" Version="$(PouryaKitVersion)" />
    <PackageVersion Include="PouryaKit.ReverseProxy" Version="$(PouryaKitVersion)" />
    <PackageVersion Include="PouryaKit.Security" Version="$(PouryaKitVersion)" />
    <PackageVersion Include="PouryaKit.Security.JwtBearer" Version="$(PouryaKitVersion)" />
    <PackageVersion Include="PouryaKit.Testing" Version="$(PouryaKitVersion)" />
    <PackageVersion Include="PouryaKit.Validation" Version="$(PouryaKitVersion)" />
    <PackageVersion Include="PouryaKit.Web" Version="$(PouryaKitVersion)" />
    <PackageVersion Include="PouryaKit.Web.OpenApi" Version="$(PouryaKitVersion)" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Core.Api" Version="2.84.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.48.3" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
</Project>
