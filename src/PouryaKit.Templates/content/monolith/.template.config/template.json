{
  "$schema": "https://json.schemastore.org/template",
  "author": "Pourya Nofallah",
  "classifications": ["Web", "API", "Monolith", "PouryaKit"],
  "identity": "PouryaKit.Templates.Monolith",
  "name": "PouryaKit monolith",
  "description": "A Host on PouryaKit that starts with one Module, the Proving Sample's Catalog, as a plain registration with IDispatcher endpoints and no Modularity; it grows into the modular monolith by adding PouryaKit.Modularity, its business code unchanged. With the service defaults and an HTTP smoke test.",
  "shortName": "pouryakit-monolith",
  "sourceName": "ModularMonolith",
  "defaultName": "Shop",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "serviceName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "queueName",
      "replaces": "modular-monolith",
      "description": "The Host's queue on a RabbitMQ broker: the name, lower-cased, each run of other characters a hyphen."
    },
    "projectName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "PouryaKitAppName",
      "description": "The name as typed, in the solution's and the project references' paths: the engine names files and folders with it, but writes the sourceName in content as the name a namespace can hold."
    },
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "If specified, skips the automatic restore of the solution on create.",
      "defaultValue": "false"
    }
  },
  "forms": {
    "queueName": {
      "identifier": "chain",
      "steps": ["lowerCaseInvariant", "hyphensForOthers", "noOuterHyphens"]
    },
    "lowerCaseInvariant": {
      "identifier": "lowerCaseInvariant"
    },
    "hyphensForOthers": {
      "identifier": "replace",
      "pattern": "[^a-z0-9]+",
      "replacement": "-"
    },
    "noOuterHyphens": {
      "identifier": "replace",
      "pattern": "^-+|-+$",
      "replacement": ""
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./"
    },
    {
      "source": "../shared/",
      "target": "./"
    },
    {
      "source": "../sample/",
      "target": "src/",
      "include": ["Modules/Catalog/**/*", "ModularMonolith.Host/**/*", "ModularMonolith.ServiceDefaults/**/*"],
      "exclude": ["**/*Module.cs", "**/*Endpoint.cs", "**/*GrpcService.cs", "**/CatalogProducts.cs", "**/AskAboutProducts/**", "**/CardNumberGuardrail.cs"]
    }
  ],
  "primaryOutputs": [
    {
      "path": "ModularMonolith.slnx"
    }
  ],
  "postActions": [
    {
      "id": "restore",
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages required by this solution.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
