    <InternalsVisibleTo Include="PouryaKit.Messaging.Wolverine" />
    <InternalsVisibleTo Include="PouryaKit.Web" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PouryaKit.Core\PouryaKit.Core.csproj" />
    <ProjectReference Include="..\PouryaKit.Domain\PouryaKit.Domain.csproj" />
  </ItemGroup>
</Project>
