  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PouryaKit.Core\PouryaKit.Core.csproj" />
    <ProjectReference Include="..\PouryaKit.Cqrs\PouryaKit.Cqrs.csproj" />
  </ItemGroup>
</Project>
