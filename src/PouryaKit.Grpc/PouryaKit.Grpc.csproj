<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageDescription>gRPC services and clients on the Kit's Web conventions: each call runs through a Module's Gateway, and a failed Result answers a gRPC status with every Error in a trailer.</PackageDescription>
    <PackageTags>grpc;protobuf;aspnetcore</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Not the Grpc.AspNetCore metapackage: it carries Grpc.Tools with include="All" into every consumer. A project that
         compiles a .proto references Grpc.Tools itself, with private assets. -->
    <PackageReference Include="Grpc.AspNetCore.Server" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PouryaKit.Web\PouryaKit.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The loopback check's comparison of bound addresses, proven against Kestrel's default without binding its port. -->
    <InternalsVisibleTo Include="ModularMonolith.Tests" />
  </ItemGroup>
</Project>
