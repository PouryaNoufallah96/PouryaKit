<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageDescription>Test against the hosted application: PostgreSQL in a Testcontainers container, data reset between tests, Operations through a Gateway, deliveries awaited and dead letters replayed.</PackageDescription>
    <PackageTags>testing;xunit;testcontainers</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Respawn" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- A test Host runs in Development, where Wolverine compiles its handler code at run time, from any build (ADR 0004). -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Kit's own Gateway-seam tests read the fixture's definition of a pending delivery for Hosts it does not host. -->
    <InternalsVisibleTo Include="ModularMonolith.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PouryaKit.Messaging.Wolverine.EFCore\PouryaKit.Messaging.Wolverine.EFCore.csproj" />
    <ProjectReference Include="..\PouryaKit.Modularity\PouryaKit.Modularity.csproj" />
    <ProjectReference Include="..\PouryaKit.Persistence.Postgres\PouryaKit.Persistence.Postgres.csproj" />
  </ItemGroup>
</Project>
