<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageDescription>ASP.NET Core endpoints beside each Feature: authenticated access by default, one problem response for every failure and outgoing HTTP that carries the Operation Context.</PackageDescription>
    <PackageTags>aspnetcore;minimal-api;problem-details</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>
  <ItemGroup>
    <!-- gRPC reuses the codec's header names, the Errors' severity and entry shape, and the Kit's refusal type. -->
    <InternalsVisibleTo Include="PouryaKit.Grpc" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PouryaKit.Core\PouryaKit.Core.csproj" />
    <ProjectReference Include="..\PouryaKit.Cqrs\PouryaKit.Cqrs.csproj" />
  </ItemGroup>
</Project>
