<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageDescription>A YARP Reverse proxy of its own process in front of a system's Hosts, with routes from configuration, service discovery, a liveness probe and one trace.</PackageDescription>
    <PackageTags>yarp;reverse-proxy;service-discovery</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery.Yarp" />
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>
</Project>
