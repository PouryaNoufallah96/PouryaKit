<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageDescription>Durable deliveries on Wolverine with the message store in PostgreSQL: Notifications, Integration Events, Snapshots, delayed and recurring commands, each retried on its own.</PackageDescription>
    <PackageTags>wolverine;outbox;postgresql;messaging</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WolverineFx" />
  </ItemGroup>
  <ItemGroup>
    <!-- A Saga's route, fan-out, checks and emissions use the registry, the routing check and the Outbox's header write. -->
    <InternalsVisibleTo Include="PouryaKit.Messaging.Wolverine.Sagas" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PouryaKit.Core\PouryaKit.Core.csproj" />
    <ProjectReference Include="..\PouryaKit.Cqrs\PouryaKit.Cqrs.csproj" />
    <ProjectReference Include="..\PouryaKit.Messaging\PouryaKit.Messaging.csproj" />
  </ItemGroup>
</Project>
