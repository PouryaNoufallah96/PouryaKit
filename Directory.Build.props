<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <_KitSourceRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'src'))</_KitSourceRoot>
    <IsKitPackage Condition="$(MSBuildProjectDirectory.StartsWith('$(_KitSourceRoot)'))">true</IsKitPackage>
    <!-- The documentation file gives each package its IntelliSense and lets the build see an unnecessary using
         (IDE0005) and an XML reference that names nothing (CS1574). CS1591 asks a summary of every public member
         of the Kit packages; the samples and the tests are spared it. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn Condition="'$(IsKitPackage)' != 'true'">$(NoWarn);CS1591</NoWarn>
    <IsPackable Condition="'$(IsKitPackage)' != 'true'">false</IsPackable>
    <DebugType Condition="'$(IsKitPackage)' == 'true'">embedded</DebugType>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>
</Project>
