{
  "name": "pouryakit-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/kit-content.ts generate && next dev",
    "build": "node scripts/kit-content.ts generate && next build && node scripts/kit-content.ts check-export",
    "lint": "biome check .",
    "check-licences": "node scripts/check-licences.mjs",
    "covers": "node scripts/covers.ts",
    "test": "node --test scripts/check-licences.test.mjs scripts/covers.test.mjs lib/kit-sources/*.test.ts"
  },
  "dependencies": {
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.8",
    "github-slugger": "2.0.0",
    "lucide-react": "1.61.0",
    "mdast-util-to-string": "4.0.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
