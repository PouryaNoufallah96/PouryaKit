root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space

[*.{cs,py}]
indent_size = 4

[*.{csproj,props,slnx,json,yml,yaml,toml,sh,ts,js}]
indent_size = 2

# The C# 14 and .NET 10 idioms of .claude/rules/kit-code.md that have an analyzer in the SDK. EnforceCodeStyleInBuild
# runs them in every build, and TreatWarningsAsErrors makes a warning fail it. Extension members, TimeProvider and
# Guid.CreateVersion7 have no analyzer; review still judges those.
[*.cs]
# Collection expressions
dotnet_diagnostic.IDE0028.severity = warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0302.severity = warning
dotnet_diagnostic.IDE0303.severity = warning
dotnet_diagnostic.IDE0304.severity = warning
dotnet_diagnostic.IDE0305.severity = warning
dotnet_diagnostic.IDE0306.severity = warning
# Primary constructors
dotnet_diagnostic.IDE0290.severity = warning
# Auto properties, including the field keyword
dotnet_diagnostic.IDE0032.severity = warning
# System.Threading.Lock
dotnet_diagnostic.IDE0330.severity = warning
# Unnecessary using directives. The analyzer runs in a build only where the documentation file is generated
# (GenerateDocumentationFile in Directory.Build.props).
dotnet_diagnostic.IDE0005.severity = warning
# Private field names: PascalCase for const and static readonly fields, _camelCase for every other private field, mutable
# statics included, whether private is written or implied. A rule's own severity reaches only the IDE; the build reads
# IDE1006's.
dotnet_diagnostic.IDE1006.severity = warning
dotnet_naming_symbols.private_const_fields.applicable_kinds = field
dotnet_naming_symbols.private_const_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_const_fields.required_modifiers = const
dotnet_naming_symbols.private_static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_rule.private_const_fields_are_pascal_case.symbols = private_const_fields
dotnet_naming_rule.private_const_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.private_const_fields_are_pascal_case.severity = warning
dotnet_naming_rule.private_static_readonly_fields_are_pascal_case.symbols = private_static_readonly_fields
dotnet_naming_rule.private_static_readonly_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.private_static_readonly_fields_are_pascal_case.severity = warning
dotnet_naming_rule.private_fields_are_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.private_fields_are_underscore_camel_case.severity = warning

# EF Core generates a migration with usings it does not need.
[**/Migrations/*.cs]
dotnet_diagnostic.IDE0005.severity = none

# ADR 0010: a Kit package keeps one namespace, its own name, in every folder.
[src/**/*.cs]
dotnet_style_namespace_match_folder = false

# ADR 0010: application code's namespaces follow its folders. IDE0130 checks it in the Proving Sample's application code
# and the test projects, but for a partial type with a second declaration, which the analyzer never reports (ADR 0010,
# Consequences); each file below is a deliberate exception.
[samples/ModularMonolith/src/**/*.cs]
dotnet_diagnostic.IDE0130.severity = warning

[tests/**/*.cs]
dotnet_diagnostic.IDE0130.severity = warning

# Aspire's convention: the service defaults extend the host builder in Microsoft.Extensions.Hosting.
[samples/ModularMonolith/src/ModularMonolith.ServiceDefaults/Extensions.cs]
dotnet_diagnostic.IDE0130.severity = none

# The Stub Module's namespace: each type here has the full name of one in the Stub's assembly.
[tests/ModularMonolith.Tests/SameNamed/StubSameNamed.cs]
dotnet_diagnostic.IDE0130.severity = none

# PouryaKit.Core's namespace: the fourth public helper the Core rule must reject.
[tests/PouryaKit.ArchitectureTests/Offending.Core/TextHelpers.cs]
dotnet_diagnostic.IDE0130.severity = none
